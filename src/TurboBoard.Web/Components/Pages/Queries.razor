@page "/queries"
@rendermode InteractiveServer
@inject IDataSourceService DataSourceService
@inject ISchemaService SchemaService
@inject IQueryPreviewService PreviewService
@inject ISavedQueryService SavedQueryService
@inject IJSRuntime JS

<PageTitle>Queries · TurboBoard</PageTitle>
<NavigationLock ConfirmExternalNavigation="@isDirty" OnBeforeInternalNavigation="ConfirmInternalNavigation" />

<header class="page-header">
    <section class="page-heading" aria-labelledby="queries-title">
        <span class="eyebrow">Visual query workspace</span>
        <h1 id="queries-title">Queries</h1>
        <p>Choose a Schema-known source and fields, then run a bounded Query Preview without writing SQL.</p>
    </section>
    <div class="query-actions"><button class="button button-secondary" type="button" @onclick="ResetAsync" disabled="@(!isDirty)">Reset</button><button class="button button-secondary" type="button" @onclick="SaveAsAsync" disabled="@(!CanSaveDefinition)">Save As</button><button class="button button-primary" type="button" @onclick="SaveAsync" disabled="@(!CanSaveDefinition && !CanSaveMetadata)">Save</button><button class="button button-primary" type="button" @onclick="PreviewAsync" disabled="@(isPreviewing || selections.Count == 0)">@(isPreviewing ? "Running preview…" : "Run preview")</button></div>
</header>

<section class="saved-query-bar" aria-label="Saved Query commands">
    <label><span>Saved Query</span><select value="@selectedSavedQueryId" @onchange="OpenSavedQueryAsync"><option value="">New Query Definition</option>@foreach (var item in savedQueries) { <option value="@item.Id">@item.Name</option> }</select></label>
    <label><span>Name</span><input value="@queryName" @oninput="ChangeName" maxlength="200" /></label>
    <label><span>Description</span><input value="@queryDescription" @oninput="ChangeDescription" maxlength="2000" /></label>
    <div class="query-actions"><button class="button button-secondary" type="button" @onclick="DuplicateAsync" disabled="@(selectedSavedQueryId is null)">Duplicate</button><button class="button button-destructive" type="button" @onclick="DeleteAsync" disabled="@(selectedSavedQueryId is null)">Delete</button></div>
</section>
<p class="muted">Meaningful unsaved changes trigger a navigation warning where browser support permits.</p>
@if (isDirty) { <p class="inline-warning" role="status">You have unsaved changes. Save or Reset before leaving this page.</p> }
@if (saveDiagnostic is not null) { <section class="feedback feedback-error" role="alert"><h2>Saved Query needs attention</h2><p><code>@saveDiagnostic.Code</code> @saveDiagnostic.Message</p></section> }
@if (!string.IsNullOrEmpty(commandMessage)) { <p class="feedback feedback-success" role="status">@commandMessage</p> }

<section class="query-editor" aria-label="Query Definition editor">
    <div class="editor-card"><h2>1. Data Source</h2><label><span>Data Source</span><select value="@selectedDataSourceId" @onchange="ChangeDataSourceAsync"><option value="">Choose a Data Source</option>@foreach (var item in dataSources) { <option value="@item.Id">@item.Name</option> }</select></label>
        @if (selectedDataSourceId is not null && schema is null) { <p class="inline-warning">Discover a Schema for this Data Source before building a query.</p> }
    </div>
    <div class="editor-card"><h2>2. Source</h2><label><span>Table or view</span><select value="@selectedObjectName" @onchange="ChangeObject"><option value="">Choose a table or view</option>@foreach (var item in schema?.Objects ?? []) { <option value="@item.QualifiedName.DisplayName">@item.QualifiedName.DisplayName · @item.Kind</option> }</select></label></div>
    <div class="editor-card field-card"><h2>3. Fields</h2>
        @if (SelectedObject is null) { <p class="muted">Choose a source to see selectable fields.</p> }
        else { <div class="field-picker">@foreach (var column in SelectedObject.Columns.Where(item => item.Capabilities.HasFlag(SchemaColumnCapabilities.Select))) { <label class="field-option"><input type="checkbox" checked="@IsSelected(column.Name)" @onchange="args => ToggleColumn(column, (bool?)args.Value == true)" /><span><strong>@column.Name</strong><small>@column.NormalizedType · @column.ProviderType</small></span></label> }</div> }
    </div>
    <div class="editor-card selection-card"><h2>4. Output</h2>
        @if (selections.Count == 0) { <p class="muted">Selected fields appear here in output order.</p> }
        @for (var index = 0; index < selections.Count; index++)
        {
            var position = index; var selection = selections[position];
            <div class="selection-row" @key="selection.ColumnName"><span class="drag-index">@(position + 1)</span><strong>@selection.ColumnName</strong><label><span>Output name</span><input value="@selection.OutputName" @oninput="args => ChangeOutputName(selection, args)" /></label><div class="row-actions"><button type="button" aria-label="Move @selection.ColumnName up" disabled="@(position == 0)" @onclick="() => Move(position, -1)">↑</button><button type="button" aria-label="Move @selection.ColumnName down" disabled="@(position == selections.Count - 1)" @onclick="() => Move(position, 1)">↓</button><button type="button" aria-label="Remove @selection.ColumnName" @onclick="() => Remove(position)">×</button></div></div>
        }
    </div>
    <div class="editor-card selection-card"><div class="panel-heading"><h2>5. Filters</h2><div class="query-actions"><label><span>Root group</span><select value="@filterRoot.Operator" @onchange="args => ChangeGroupOperator(filterRoot, args)"><option value="And">AND</option><option value="Or">OR</option></select></label><button class="button button-secondary button-small" type="button" @onclick="() => AddFilter(filterRoot)" disabled="@(SelectedObject?.Columns.Any(item => item.Capabilities.HasFlag(SchemaColumnCapabilities.Filter)) != true)">Add condition</button><button class="button button-secondary button-small" type="button" @onclick="() => AddGroup(filterRoot)">Add group</button><button class="button button-secondary button-small" type="button" @onclick="RegroupSelected" disabled="@(!FilterRows().Any(item => item.Node.IsSelected))">Group selected</button></div></div>
        @if (filterRoot.Children.Count == 0) { <p class="muted">Add fixed-value conditions or groups. Every value is sent to the database as a parameter.</p> }
        @foreach (var row in FilterRows())
        {
            var node = row.Node;
            <div class="filter-row" style="margin-left: @(row.Depth * 1.25)rem" @key="node.Id">
                <label class="filter-toggle"><input type="checkbox" checked="@node.IsSelected" @onchange="args => SelectNode(node, (bool?)args.Value == true)" /><span>Select</span></label>
                <label class="filter-toggle"><input type="checkbox" checked="@node.IsEnabled" @onchange="args => EnableNode(node, (bool?)args.Value == true)" /><span>Enabled</span></label>
                @if (node is EditorGroup group)
                {
                    <label><span>Group</span><select value="@group.Operator" @onchange="args => ChangeGroupOperator(group, args)"><option value="And">AND</option><option value="Or">OR</option></select></label><button class="button button-secondary button-small" type="button" @onclick="() => AddFilter(group)">Add condition</button><button class="button button-secondary button-small" type="button" @onclick="() => AddGroup(group)">Add group</button>
                }
                else if (node is EditorCondition condition)
                {
                    var column = FilterColumn(condition);
                    <label><span>Column</span><select value="@condition.ColumnName" @onchange="args => ChangeFilterColumn(condition, args)">@foreach (var item in SelectedObject?.Columns.Where(item => item.Capabilities.HasFlag(SchemaColumnCapabilities.Filter)) ?? []) { <option value="@item.Name">@item.Name · @item.NormalizedType</option> }</select></label>
                    <label><span>Operator</span><select value="@condition.Operator" @onchange="args => ChangeFilterOperator(condition, args)">@foreach (var item in QueryEngine.OperatorsFor(column?.NormalizedType ?? NormalizedTypeCategory.Unknown)) { <option value="@item">@OperatorLabel(item)</option> }</select></label>
                    @if (NeedsValues(condition.Operator)) { <label><span>@(condition.Operator is QueryFilterOperator.In or QueryFilterOperator.NotIn ? "Values, comma separated" : "Value")</span><input value="@condition.Value" @oninput="args => ChangeFilterValue(condition, args)" /></label> }
                    @if (condition.Operator == QueryFilterOperator.Between) { <label><span>And</span><input value="@condition.SecondValue" @oninput="args => ChangeFilterSecondValue(condition, args)" /></label> }
                }
                <button class="button button-secondary button-small" type="button" @onclick="() => ToggleNegation(node)">@(node.IsNegated ? "Remove NOT" : "NOT")</button><button class="button button-secondary button-small" type="button" @onclick="() => DuplicateNode(node)">Duplicate</button><button class="filter-remove" type="button" aria-label="Remove filter expression" @onclick="() => RemoveNode(node)">×</button>
            </div>
        }
    </div>
</section>

@if (preview?.Diagnostics.Count > 0) { <section class="feedback feedback-error" role="alert" aria-labelledby="validation-title"><h2 id="validation-title">Query Definition needs attention</h2><ul>@foreach (var diagnostic in preview.Diagnostics) { <li><code>@diagnostic.Code</code> @diagnostic.Message</li> }</ul></section> }
else if (preview?.Status == QueryPreviewStatus.Failed) { <section class="feedback feedback-error" role="alert"><h2>Query Preview failed</h2><p>@preview.FailureMessage</p></section> }

@if (preview?.GeneratedSql is not null) { <section class="preview-panel" aria-labelledby="sql-title"><div class="panel-heading"><h2 id="sql-title">Generated SQL</h2><span>Values remain parameterized</span></div><pre><code>@preview.GeneratedSql</code></pre></section> }

@if (preview?.Result is not null)
{
    <section class="preview-panel" aria-labelledby="results-title"><div class="panel-heading"><h2 id="results-title">Dynamic Result</h2><span>@preview.Result.RowCount rows · @preview.Result.Duration.TotalMilliseconds.ToString("N0") ms@if (preview.Result.WasTruncated) { <text> · Truncated</text> }</span></div>
        @if (preview.Result.RowCount == 0) { <p class="empty-result">The Query Preview returned no rows.</p> }
        else { <div class="result-wrap"><table><thead><tr>@foreach (var column in preview.Result.Columns) { <th scope="col">@column.Name<small>@column.NormalizedType</small></th> }</tr></thead><tbody>@foreach (var row in preview.Result.Rows) { <tr>@foreach (var value in row.Values) { <td>@FormatValue(value)</td> }</tr> }</tbody></table></div> }
    </section>
}

@code {
    private IReadOnlyList<DataSourceSummary> dataSources = [];
    private IReadOnlyList<SavedQuerySummary> savedQueries = [];
    private Guid? selectedSavedQueryId;
    private string queryName = string.Empty;
    private string queryDescription = string.Empty;
    private bool isDirty;
    private ValidationDiagnostic? saveDiagnostic;
    private string? commandMessage;
    private Guid? selectedDataSourceId;
    private DataSourceSchema? schema;
    private string selectedObjectName = string.Empty;
    private Guid sourceId = Guid.NewGuid();
    private readonly List<EditorSelection> selections = [];
    private EditorGroup filterRoot = new(QueryFilterGroupOperator.And);
    private QueryPreviewResponse? preview;
    private bool isPreviewing;
    private SchemaDatabaseObject? SelectedObject => schema?.Objects.SingleOrDefault(item => item.QualifiedName.DisplayName == selectedObjectName);
    private bool CanSaveDefinition => selectedDataSourceId is not null && SelectedObject is not null && selections.Count > 0 && !string.IsNullOrWhiteSpace(queryName) && saveDiagnostic is null;
    private bool CanSaveMetadata => selectedSavedQueryId is not null && saveDiagnostic is not null && !string.IsNullOrWhiteSpace(queryName);
    protected override async Task OnInitializedAsync() { dataSources = await DataSourceService.ListAsync(); savedQueries = await SavedQueryService.ListAsync(); }
    private async Task ChangeDataSourceAsync(ChangeEventArgs args) { if (!await ConfirmDiscardAsync()) return; selectedDataSourceId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null; schema = selectedDataSourceId is null ? null : await SchemaService.GetAsync(selectedDataSourceId.Value); savedQueries = selectedDataSourceId is null ? [] : await SavedQueryService.ListAsync(selectedDataSourceId.Value); selectedSavedQueryId = null; queryName = string.Empty; queryDescription = string.Empty; ResetSource(); MarkDirty(); }
    private void ChangeObject(ChangeEventArgs args) { selectedObjectName = args.Value?.ToString() ?? string.Empty; sourceId = Guid.NewGuid(); selections.Clear(); filterRoot = new(QueryFilterGroupOperator.And); preview = null; MarkDirty(); }
    private void ResetSource() { selectedObjectName = string.Empty; sourceId = Guid.NewGuid(); selections.Clear(); filterRoot = new(QueryFilterGroupOperator.And); preview = null; }
    private bool IsSelected(string columnName) => selections.Any(item => item.ColumnName == columnName);
    private void ToggleColumn(SchemaColumn column, bool selected) { if (selected && !IsSelected(column.Name)) selections.Add(new(column.Name, SafeOutputName(column.Name))); if (!selected) selections.RemoveAll(item => item.ColumnName == column.Name); MarkDirty(); }
    private void Move(int index, int offset) { var item = selections[index]; selections.RemoveAt(index); selections.Insert(index + offset, item); MarkDirty(); }
    private void Remove(int index) { selections.RemoveAt(index); MarkDirty(); }
    private async Task PreviewAsync() { var definition = CurrentDefinition(); if (selectedDataSourceId is null || definition is null) return; isPreviewing = true; try { preview = await PreviewService.PreviewAsync(selectedDataSourceId.Value, definition); } finally { isPreviewing = false; } }
    private void ChangeName(ChangeEventArgs args) { queryName = args.Value?.ToString() ?? string.Empty; MarkDirty(); }
    private void ChangeDescription(ChangeEventArgs args) { queryDescription = args.Value?.ToString() ?? string.Empty; MarkDirty(); }
    private void ChangeOutputName(EditorSelection selection, ChangeEventArgs args) { selection.OutputName = args.Value?.ToString() ?? string.Empty; MarkDirty(); }
    private void MarkDirty() { isDirty = true; commandMessage = null; }
    private QueryDefinition? CurrentDefinition() => selectedDataSourceId is null || SelectedObject is null ? null : new(QueryDefinition.CurrentVersion, new(sourceId, SelectedObject.QualifiedName), selections.Select(item => new QuerySelection(sourceId, item.ColumnName, item.OutputName)).ToArray(), FilterExpression: filterRoot.Children.Count == 0 ? null : ToQueryExpression(filterRoot));
    private async Task SaveAsync() { if (CanSaveMetadata && selectedSavedQueryId is Guid id) { await SavedQueryService.UpdateMetadataAsync(id, queryName, queryDescription); savedQueries = await SavedQueryService.ListAsync(selectedDataSourceId!.Value); isDirty = false; commandMessage = "Saved Query metadata updated."; return; } await PersistAsync(selectedSavedQueryId); }
    private async Task SaveAsAsync() => await PersistAsync(null);
    private async Task PersistAsync(Guid? id) { var definition = CurrentDefinition(); if (selectedDataSourceId is null || definition is null) return; try { selectedSavedQueryId = await SavedQueryService.SaveAsync(id, new(selectedDataSourceId.Value, queryName, queryDescription, definition)); savedQueries = await SavedQueryService.ListAsync(selectedDataSourceId.Value); isDirty = false; saveDiagnostic = null; commandMessage = id is null ? "Saved as a new Saved Query." : "Saved Query updated."; } catch (SavedQueryValidationException exception) { saveDiagnostic = new("query.saved.invalid", string.Join(" ", exception.Diagnostics)); } }
    private async Task OpenSavedQueryAsync(ChangeEventArgs args) { if (!await ConfirmDiscardAsync()) return; if (!Guid.TryParse(args.Value?.ToString(), out var id)) { selectedSavedQueryId = null; return; } await LoadSavedQueryAsync(id); }
    private async Task LoadSavedQueryAsync(Guid id) { var saved = await SavedQueryService.GetAsync(id); if (saved is null) return; selectedSavedQueryId = saved.Id; selectedDataSourceId = saved.DataSourceId; schema = await SchemaService.GetAsync(saved.DataSourceId); savedQueries = await SavedQueryService.ListAsync(saved.DataSourceId); queryName = saved.Name; queryDescription = saved.Description; saveDiagnostic = saved.Diagnostic; preview = null; selections.Clear(); filterRoot = new(QueryFilterGroupOperator.And); if (saved.Definition is not null) { sourceId = saved.Definition.Source.Id; selectedObjectName = saved.Definition.Source.Object.DisplayName; selections.AddRange(saved.Definition.Selections.Select(item => new EditorSelection(item.ColumnName, item.OutputName))); filterRoot = saved.Definition.FilterExpression is null ? EditorGroup.FromLegacy(saved.Definition.AvailableFilters) : EditorGroup.FromExpression(saved.Definition.FilterExpression); } else { selectedObjectName = string.Empty; sourceId = Guid.NewGuid(); } isDirty = false; commandMessage = null; }
    private async Task ResetAsync() { if (selectedSavedQueryId is Guid id) await LoadSavedQueryAsync(id); else { queryName = string.Empty; queryDescription = string.Empty; ResetSource(); isDirty = false; saveDiagnostic = null; commandMessage = "Unsaved changes reset."; } }
    private async Task DuplicateAsync() { if (selectedSavedQueryId is not Guid id) return; var duplicateId = await SavedQueryService.DuplicateAsync(id, $"{queryName} copy"); await LoadSavedQueryAsync(duplicateId); commandMessage = "Saved Query duplicated."; }
    private async Task DeleteAsync() { if (selectedSavedQueryId is not Guid id || selectedDataSourceId is null) return; await SavedQueryService.DeleteAsync(id); savedQueries = await SavedQueryService.ListAsync(selectedDataSourceId.Value); selectedSavedQueryId = null; queryName = string.Empty; queryDescription = string.Empty; ResetSource(); isDirty = false; saveDiagnostic = null; commandMessage = "Saved Query deleted."; }
    private async Task ConfirmInternalNavigation(LocationChangingContext context) { if (isDirty && !await JS.InvokeAsync<bool>("confirm", "You have unsaved changes. Leave this page and discard them?")) context.PreventNavigation(); }
    private async Task<bool> ConfirmDiscardAsync() => !isDirty || await JS.InvokeAsync<bool>("confirm", "You have unsaved changes. Discard them and open another Query Definition?");
    private SchemaColumn? FilterColumn(EditorCondition filter) => SelectedObject?.Columns.SingleOrDefault(item => item.Name == filter.ColumnName);
    private IReadOnlyList<NodeRow> FilterRows() { var rows = new List<NodeRow>(); AddRows(filterRoot, 0, rows); return rows; }
    private static void AddRows(EditorGroup group, int depth, ICollection<NodeRow> rows) { foreach (var child in group.Children) { rows.Add(new(child, depth)); if (child is EditorGroup nested) AddRows(nested, depth + 1, rows); } }
    private void AddFilter(EditorGroup parent) { var column = SelectedObject?.Columns.FirstOrDefault(item => item.Capabilities.HasFlag(SchemaColumnCapabilities.Filter)); if (column is null) return; parent.Children.Add(new EditorCondition(column.Name, QueryEngine.OperatorsFor(column.NormalizedType).First())); MarkDirty(); }
    private void AddGroup(EditorGroup parent) { parent.Children.Add(new EditorGroup(QueryFilterGroupOperator.And)); MarkDirty(); }
    private void ChangeFilterColumn(EditorCondition filter, ChangeEventArgs args) { filter.ColumnName = args.Value?.ToString() ?? string.Empty; var column = FilterColumn(filter); filter.Operator = QueryEngine.OperatorsFor(column?.NormalizedType ?? NormalizedTypeCategory.Unknown).FirstOrDefault(); filter.Value = string.Empty; filter.SecondValue = string.Empty; MarkDirty(); }
    private void ChangeFilterOperator(EditorCondition filter, ChangeEventArgs args) { if (Enum.TryParse<QueryFilterOperator>(args.Value?.ToString(), out var value)) filter.Operator = value; filter.Value = string.Empty; filter.SecondValue = string.Empty; MarkDirty(); }
    private void ChangeFilterValue(EditorCondition filter, ChangeEventArgs args) { filter.Value = args.Value?.ToString() ?? string.Empty; MarkDirty(); }
    private void ChangeFilterSecondValue(EditorCondition filter, ChangeEventArgs args) { filter.SecondValue = args.Value?.ToString() ?? string.Empty; MarkDirty(); }
    private void ChangeGroupOperator(EditorGroup group, ChangeEventArgs args) { if (Enum.TryParse<QueryFilterGroupOperator>(args.Value?.ToString(), out var value)) group.Operator = value; MarkDirty(); }
    private void SelectNode(EditorNode node, bool selected) => node.IsSelected = selected;
    private void EnableNode(EditorNode node, bool enabled) { node.IsEnabled = enabled; MarkDirty(); }
    private void ToggleNegation(EditorNode node) { node.IsNegated = !node.IsNegated; node.NotId ??= Guid.NewGuid(); MarkDirty(); }
    private void DuplicateNode(EditorNode node) { var parent = FindParent(filterRoot, node); if (parent is null) return; var index = parent.Children.IndexOf(node); parent.Children.Insert(index + 1, node.Clone()); MarkDirty(); }
    private void RemoveNode(EditorNode node) { var parent = FindParent(filterRoot, node); if (parent is null) return; parent.Children.Remove(node); MarkDirty(); }
    private void RegroupSelected()
    {
        var selectedIds = FilterRows().Where(item => item.Node.IsSelected).Select(item => item.Node.Id).ToHashSet();
        var selected = FilterRows().Where(item => item.Node.IsSelected && !HasSelectedAncestor(item.Node, selectedIds)).Select(item => item.Node).ToArray();
        if (selected.Length == 0) return;
        var parents = selected.Select(node => FindParent(filterRoot, node)).ToArray();
        if (parents.Any(parent => parent is null)) return;
        var target = parents.All(parent => parent == parents[0]) ? parents[0]! : filterRoot;
        var insertionIndex = target == parents[0] ? target.Children.IndexOf(selected[0]) : target.Children.Count;
        foreach (var node in selected) FindParent(filterRoot, node)!.Children.Remove(node);
        if (target == filterRoot) foreach (var parent in parents.Where(parent => parent != filterRoot).Distinct().Cast<EditorGroup>().ToArray()) RemoveEmptyAncestors(parent);
        foreach (var node in selected) node.IsSelected = false;
        var group = new EditorGroup(QueryFilterGroupOperator.And);
        group.Children.AddRange(selected);
        target.Children.Insert(Math.Min(insertionIndex, target.Children.Count), group);
        MarkDirty();
    }
    private bool HasSelectedAncestor(EditorNode node, ISet<Guid> selectedIds) { var parent = FindParent(filterRoot, node); while (parent is not null && parent != filterRoot) { if (selectedIds.Contains(parent.Id)) return true; parent = FindParent(filterRoot, parent); } return false; }
    private void RemoveEmptyAncestors(EditorGroup group) { var current = group; while (current != filterRoot && current.Children.Count == 0) { var parent = FindParent(filterRoot, current); if (parent is null) return; parent.Children.Remove(current); current = parent; } }
    private static EditorGroup? FindParent(EditorGroup parent, EditorNode target) { if (parent.Children.Contains(target)) return parent; foreach (var group in parent.Children.OfType<EditorGroup>()) { var found = FindParent(group, target); if (found is not null) return found; } return null; }
    private static bool NeedsValues(QueryFilterOperator value) => value is not QueryFilterOperator.IsNull and not QueryFilterOperator.IsNotNull;
    private QueryFilterExpression ToQueryExpression(EditorNode node) { QueryFilterExpression expression = node switch { EditorCondition condition => new QueryFilterCondition(condition.Id, true, ToQueryFilter(condition)), EditorGroup group => new QueryFilterGroup(group.Id, true, group.Operator, group.Children.Select(ToQueryExpression).ToArray()), _ => throw new InvalidOperationException() }; if (node.IsNegated) expression = new QueryFilterNot(node.NotId ??= Guid.NewGuid(), node.IsEnabled, expression); else expression = expression switch { QueryFilterCondition condition => condition with { IsEnabled = node.IsEnabled }, QueryFilterGroup group => group with { IsEnabled = node.IsEnabled }, _ => expression }; return expression; }
    private QueryFilter ToQueryFilter(EditorCondition filter) { IReadOnlyList<string?> values = filter.Operator switch { QueryFilterOperator.IsNull or QueryFilterOperator.IsNotNull => [], QueryFilterOperator.Between => [filter.Value, filter.SecondValue], QueryFilterOperator.In or QueryFilterOperator.NotIn => filter.Value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries), _ => [filter.Value] }; return new(sourceId, filter.ColumnName, filter.Operator, values); }
    private static string OperatorLabel(QueryFilterOperator value) => value switch { QueryFilterOperator.Equal => "Equals", QueryFilterOperator.NotEqual => "Does not equal", QueryFilterOperator.LessThan => "Less than", QueryFilterOperator.LessThanOrEqual => "Less than or equal", QueryFilterOperator.GreaterThan => "Greater than", QueryFilterOperator.GreaterThanOrEqual => "Greater than or equal", QueryFilterOperator.NotLike => "Not like", QueryFilterOperator.StartsWith => "Starts with", QueryFilterOperator.EndsWith => "Ends with", QueryFilterOperator.NotIn => "Not in", QueryFilterOperator.IsNull => "Is null", QueryFilterOperator.IsNotNull => "Is not null", _ => value.ToString() };
    private static string SafeOutputName(string name) { var candidate = new string(name.Select(character => char.IsLetterOrDigit(character) || character == '_' ? character : '_').ToArray()); return candidate.Length > 0 && char.IsDigit(candidate[0]) ? $"_{candidate}" : candidate; }
    private static string FormatValue(object? value) => value switch { null => "NULL", DateTime dateTime => dateTime.ToString("u"), DateTimeOffset offset => offset.ToString("u"), byte[] bytes => $"{bytes.Length} bytes", _ => Convert.ToString(value, System.Globalization.CultureInfo.CurrentCulture) ?? string.Empty };
    private sealed class EditorSelection(string columnName, string outputName) { public string ColumnName { get; } = columnName; public string OutputName { get; set; } = outputName; }
    private sealed record NodeRow(EditorNode Node, int Depth);
    private abstract class EditorNode(Guid? id = null) { public Guid Id { get; } = id ?? Guid.NewGuid(); public bool IsEnabled { get; set; } = true; public bool IsSelected { get; set; } public bool IsNegated { get; set; } public Guid? NotId { get; set; } public abstract EditorNode Clone(); }
    private sealed class EditorCondition(string columnName, QueryFilterOperator @operator, Guid? id = null) : EditorNode(id) { public string ColumnName { get; set; } = columnName; public QueryFilterOperator Operator { get; set; } = @operator; public string Value { get; set; } = string.Empty; public string SecondValue { get; set; } = string.Empty; public override EditorNode Clone() => new EditorCondition(ColumnName, Operator) { Value = Value, SecondValue = SecondValue, IsEnabled = IsEnabled, IsNegated = IsNegated, NotId = IsNegated ? Guid.NewGuid() : null }; public static EditorCondition From(QueryFilterCondition condition) { var editor = new EditorCondition(condition.Filter.ColumnName, condition.Filter.Operator, condition.Id) { IsEnabled = condition.IsEnabled }; editor.Value = condition.Filter.Operator is QueryFilterOperator.In or QueryFilterOperator.NotIn ? string.Join(", ", condition.Filter.Values) : condition.Filter.Values.FirstOrDefault() ?? string.Empty; editor.SecondValue = condition.Filter.Values.Skip(1).FirstOrDefault() ?? string.Empty; return editor; } }
    private sealed class EditorGroup(QueryFilterGroupOperator @operator, Guid? id = null) : EditorNode(id) { public QueryFilterGroupOperator Operator { get; set; } = @operator; public List<EditorNode> Children { get; } = []; public override EditorNode Clone() { var copy = new EditorGroup(Operator) { IsEnabled = IsEnabled, IsNegated = IsNegated, NotId = IsNegated ? Guid.NewGuid() : null }; copy.Children.AddRange(Children.Select(item => item.Clone())); return copy; } public static EditorGroup FromLegacy(IReadOnlyList<QueryFilter> filters) { var group = new EditorGroup(QueryFilterGroupOperator.And); group.Children.AddRange(filters.Select(filter => EditorCondition.From(new(Guid.NewGuid(), true, filter)))); return group; } public static EditorGroup FromExpression(QueryFilterExpression expression) { var node = FromNode(expression); if (node is EditorGroup group) return group; var root = new EditorGroup(QueryFilterGroupOperator.And); root.Children.Add(node); return root; } private static EditorNode FromNode(QueryFilterExpression expression) { if (expression is QueryFilterNot not) { var operand = FromNode(not.Operand); operand.IsNegated = true; operand.NotId = not.Id; operand.IsEnabled = not.IsEnabled; return operand; } return expression switch { QueryFilterCondition condition => EditorCondition.From(condition), QueryFilterGroup group => FromGroup(group), _ => throw new InvalidOperationException("Unsupported filter expression.") }; } private static EditorGroup FromGroup(QueryFilterGroup group) { var editor = new EditorGroup(group.Operator, group.Id) { IsEnabled = group.IsEnabled }; editor.Children.AddRange(group.Children.Select(FromNode)); return editor; } }
}
