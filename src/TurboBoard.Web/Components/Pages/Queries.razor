@page "/queries"
@rendermode InteractiveServer
@inject IDataSourceService DataSourceService
@inject ISchemaService SchemaService
@inject IQueryPreviewService PreviewService
@inject ISavedQueryService SavedQueryService
@inject IJSRuntime JS

<PageTitle>Queries · TurboBoard</PageTitle>
<NavigationLock ConfirmExternalNavigation="@isDirty" OnBeforeInternalNavigation="ConfirmInternalNavigation" />

<header class="page-header">
    <section class="page-heading" aria-labelledby="queries-title">
        <span class="eyebrow">Visual query workspace</span>
        <h1 id="queries-title">Queries</h1>
        <p>Choose a Schema-known source and fields, then run a bounded Query Preview without writing SQL.</p>
    </section>
    <div class="query-actions"><button class="button button-secondary" type="button" @onclick="ResetAsync" disabled="@(!isDirty)">Reset</button><button class="button button-secondary" type="button" @onclick="SaveAsAsync" disabled="@(!CanSaveDefinition)">Save As</button><button class="button button-primary" type="button" @onclick="SaveAsync" disabled="@(!CanSaveDefinition && !CanSaveMetadata)">Save</button><button class="button button-primary" type="button" @onclick="PreviewAsync" disabled="@(isPreviewing || selections.Count == 0)">@(isPreviewing ? "Running preview…" : "Run preview")</button></div>
</header>

<section class="saved-query-bar" aria-label="Saved Query commands">
    <label><span>Saved Query</span><select value="@selectedSavedQueryId" @onchange="OpenSavedQueryAsync"><option value="">New Query Definition</option>@foreach (var item in savedQueries) { <option value="@item.Id">@item.Name</option> }</select></label>
    <label><span>Name</span><input value="@queryName" @oninput="ChangeName" maxlength="200" /></label>
    <label><span>Description</span><input value="@queryDescription" @oninput="ChangeDescription" maxlength="2000" /></label>
    <div class="query-actions"><button class="button button-secondary" type="button" @onclick="DuplicateAsync" disabled="@(selectedSavedQueryId is null)">Duplicate</button><button class="button button-destructive" type="button" @onclick="DeleteAsync" disabled="@(selectedSavedQueryId is null)">Delete</button></div>
</section>
<p class="muted">Meaningful unsaved changes trigger a navigation warning where browser support permits.</p>
@if (isDirty) { <p class="inline-warning" role="status">You have unsaved changes. Save or Reset before leaving this page.</p> }
@if (saveDiagnostic is not null) { <section class="feedback feedback-error" role="alert"><h2>Saved Query needs attention</h2><p><code>@saveDiagnostic.Code</code> @saveDiagnostic.Message</p></section> }
@if (!string.IsNullOrEmpty(commandMessage)) { <p class="feedback feedback-success" role="status">@commandMessage</p> }

<section class="query-editor" aria-label="Query Definition editor">
    <div class="editor-card"><h2>1. Data Source</h2><label><span>Data Source</span><select value="@selectedDataSourceId" @onchange="ChangeDataSourceAsync"><option value="">Choose a Data Source</option>@foreach (var item in dataSources) { <option value="@item.Id">@item.Name</option> }</select></label>
        @if (selectedDataSourceId is not null && schema is null) { <p class="inline-warning">Discover a Schema for this Data Source before building a query.</p> }
    </div>
    <div class="editor-card"><h2>2. Source</h2><label><span>Table or view</span><select value="@selectedObjectName" @onchange="ChangeObject"><option value="">Choose a table or view</option>@foreach (var item in schema?.Objects ?? []) { <option value="@item.QualifiedName.DisplayName">@item.QualifiedName.DisplayName · @item.Kind</option> }</select></label></div>
    <div class="editor-card selection-card"><div class="panel-heading"><h2>3. Joins</h2></div>
        @if (SelectedObject is null) { <p class="muted">Choose a source before adding related objects.</p> }
        else
        {
            <button class="button button-secondary button-small" type="button" @onclick="() => showJoinEditor = true">Add related object</button>
            @if (showJoinEditor)
            {
            <div class="selection-row">
                <label><span>Join from</span><select class="join-left-source" value="@joinLeftSourceId" @onchange="ChangeJoinLeftSource">@foreach (var item in LogicalSources()) { <option value="@item.Source.Id">@(item.Source.Alias ?? item.Source.Object.DisplayName)</option> }</select></label>
                <label><span>Related object</span><select class="join-object" value="@joinObjectName" @onchange="ChangeJoinObject"><option value="">Choose an object</option>@foreach (var item in schema?.Objects ?? []) { <option value="@item.QualifiedName.DisplayName">@item.QualifiedName.DisplayName</option> }</select></label>
                <label><span>Alias</span><input class="join-alias" value="@joinAlias" @oninput="args => joinAlias = args.Value?.ToString() ?? string.Empty" /></label>
                <label><span>Match</span><select class="join-relationship" value="@joinRelationshipName" @onchange="ChangeJoinRelationship"><option value="">Choose a Relationship</option>@foreach (var item in JoinRelationships) { <option value="@item.Name">@item.Name</option> }<option value="manual">Manual column match</option></select></label>
                <label><span>Join type</span><select class="join-type" value="@joinType" @onchange="ChangeJoinType"><option value="Inner">INNER</option><option value="Left">LEFT</option></select></label>
                @if (joinRelationshipName == "manual")
                {
                    <label><span>Source column</span><select class="join-left-column" value="@joinLeftColumn" @onchange="args => joinLeftColumn = args.Value?.ToString() ?? string.Empty"><option value="">Choose a column</option>@foreach (var item in JoinLeftObject?.Columns ?? []) { <option value="@item.Name">@item.Name · @item.NormalizedType</option> }</select></label>
                    <label><span>Related column</span><select class="join-right-column" value="@joinRightColumn" @onchange="args => joinRightColumn = args.Value?.ToString() ?? string.Empty"><option value="">Choose a compatible column</option>@foreach (var item in CompatibleJoinColumns()) { <option value="@item.Name">@item.Name · @item.NormalizedType</option> }</select></label>
                }
                <button class="button button-secondary button-small add-join" type="button" @onclick="AddJoin" disabled="@(!CanAddJoin)">Add join</button>
            </div>
            @if (JoinRelationships.Count > 1 && string.IsNullOrEmpty(joinRelationshipName)) { <p class="inline-warning">More than one Relationship matches. Choose the intended path.</p> }
            }
            @for (var index = 0; index < joins.Count; index++)
            {
                var position = index; var join = joins[position];
                <div class="selection-row join-row" @key="join.Id"><span class="drag-index">@(position + 1)</span><strong>@join.Type @(join.Source.Alias ?? join.Source.Object.DisplayName)</strong><span>@JoinDescription(join)</span><div class="row-actions"><button type="button" aria-label="Move join up" disabled="@(!CanMoveJoin(position, -1))" @onclick="() => MoveJoin(position, -1)">↑</button><button type="button" aria-label="Move join down" disabled="@(!CanMoveJoin(position, 1))" @onclick="() => MoveJoin(position, 1)">↓</button><button type="button" aria-label="Remove join" disabled="@(!CanRemoveJoin(position))" @onclick="() => RemoveJoin(position)">×</button></div></div>
            }
        }
    </div>
    <div class="editor-card field-card"><h2>4. Fields</h2>
        @if (SelectedObject is null) { <p class="muted">Choose a source to see selectable fields.</p> }
        else { <div class="field-picker">@foreach (var logical in LogicalSources()) { @foreach (var column in logical.Object.Columns.Where(item => item.Capabilities.HasFlag(SchemaColumnCapabilities.Select))) { <label class="field-option"><input type="checkbox" checked="@IsSelected(logical.Source.Id, column.Name)" @onchange="args => ToggleColumn(logical.Source, column, (bool?)args.Value == true)" /><span><strong>@(logical.Source.Alias ?? logical.Source.Object.DisplayName).@column.Name</strong><small>@column.NormalizedType · @column.ProviderType</small></span></label> } }</div> }
    </div>
    <div class="editor-card selection-card"><h2>4. Output</h2>
        @if (selections.Count == 0) { <p class="muted">Selected fields appear here in output order.</p> }
        @for (var index = 0; index < selections.Count; index++)
        {
            var position = index; var selection = selections[position];
            <div class="selection-row" @key="selection.Id"><span class="drag-index">@(position + 1)</span><strong>@SelectionLabel(selection)</strong><label><span>Output name</span><input value="@selection.OutputName" @oninput="args => ChangeOutputName(selection, args)" /></label><div class="row-actions"><button type="button" aria-label="Move @selection.ColumnName up" disabled="@(position == 0)" @onclick="() => Move(position, -1)">↑</button><button type="button" aria-label="Move @selection.ColumnName down" disabled="@(position == selections.Count - 1)" @onclick="() => Move(position, 1)">↓</button><button type="button" aria-label="Remove @selection.ColumnName" @onclick="() => Remove(position)">×</button></div></div>
        }
    </div>
    <div class="editor-card selection-card"><div class="panel-heading"><h2>5. Filters</h2><div class="query-actions"><label><span>Root group</span><select value="@filterRoot.Operator" @onchange="args => ChangeGroupOperator(filterRoot, args)"><option value="And">AND</option><option value="Or">OR</option></select></label><button class="button button-secondary button-small" type="button" @onclick="() => AddFilter(filterRoot)" disabled="@(SelectedObject?.Columns.Any(item => item.Capabilities.HasFlag(SchemaColumnCapabilities.Filter)) != true)">Add condition</button><button class="button button-secondary button-small" type="button" @onclick="() => AddGroup(filterRoot)">Add group</button><button class="button button-secondary button-small" type="button" @onclick="RegroupSelected" disabled="@(!FilterRows().Any(item => item.Node.IsSelected))">Group selected</button></div></div>
        @if (filterRoot.Children.Count == 0) { <p class="muted">Add fixed-value conditions or groups. Every value is sent to the database as a parameter.</p> }
        @foreach (var row in FilterRows())
        {
            var node = row.Node;
            <div class="filter-row" style="margin-left: @(row.Depth * 1.25)rem" @key="node.Id">
                <label class="filter-toggle"><input type="checkbox" checked="@node.IsSelected" @onchange="args => SelectNode(node, (bool?)args.Value == true)" /><span>Select</span></label>
                <label class="filter-toggle"><input type="checkbox" checked="@node.IsEnabled" @onchange="args => EnableNode(node, (bool?)args.Value == true)" /><span>Enabled</span></label>
                @if (node is EditorGroup group)
                {
                    <label><span>Group</span><select value="@group.Operator" @onchange="args => ChangeGroupOperator(group, args)"><option value="And">AND</option><option value="Or">OR</option></select></label><button class="button button-secondary button-small" type="button" @onclick="() => AddFilter(group)">Add condition</button><button class="button button-secondary button-small" type="button" @onclick="() => AddGroup(group)">Add group</button>
                }
                else if (node is EditorCondition condition)
                {
                    var column = FilterColumn(condition);
                    <label><span>Column</span><select value="@FilterColumnKey(condition)" @onchange="args => ChangeFilterColumn(condition, args)">@foreach (var logical in LogicalSources()) { @foreach (var item in logical.Object.Columns.Where(item => item.Capabilities.HasFlag(SchemaColumnCapabilities.Filter))) { <option value="@(logical.Source.Id):@item.Name">@(logical.Source.Alias ?? logical.Source.Object.DisplayName).@item.Name · @item.NormalizedType</option> } }</select></label>
                    <label><span>Operator</span><select value="@condition.Operator" @onchange="args => ChangeFilterOperator(condition, args)">@foreach (var item in QueryEngine.OperatorsFor(column?.NormalizedType ?? NormalizedTypeCategory.Unknown)) { <option value="@item">@OperatorLabel(item)</option> }</select></label>
                    @if (NeedsValues(condition.Operator))
                    {
                        <label><span>Operand</span><select class="operand-kind" value="@(condition.ParameterName is null ? "fixed" : "parameter")" @onchange="args => ChangeOperandKind(condition, false, args)"><option value="fixed">Fixed value</option><option value="parameter">Query Parameter</option></select></label>
                        @if (condition.ParameterName is not null) { <label><span>Query Parameter</span><select class="parameter-reference" value="@condition.ParameterName" @onchange="args => ChangeParameterReference(condition, false, args)"><option value="">Choose a Query Parameter</option>@foreach (var item in CompatibleParameters(column)) { <option value="@item.Name">@item.DisplayName</option> }</select></label> }
                        else { <label><span>@(condition.Operator is QueryFilterOperator.In or QueryFilterOperator.NotIn ? "Values, comma separated" : "Value")</span><input value="@condition.Value" @oninput="args => ChangeFilterValue(condition, args)" /></label> }
                    }
                    @if (condition.Operator == QueryFilterOperator.Between)
                    {
                        <label><span>Second operand</span><select class="operand-kind" value="@(condition.SecondParameterName is null ? "fixed" : "parameter")" @onchange="args => ChangeOperandKind(condition, true, args)"><option value="fixed">Fixed value</option><option value="parameter">Query Parameter</option></select></label>
                        @if (condition.SecondParameterName is not null) { <label><span>Query Parameter</span><select class="parameter-reference" value="@condition.SecondParameterName" @onchange="args => ChangeParameterReference(condition, true, args)"><option value="">Choose a Query Parameter</option>@foreach (var item in CompatibleParameters(column)) { <option value="@item.Name">@item.DisplayName</option> }</select></label> }
                        else { <label><span>And</span><input value="@condition.SecondValue" @oninput="args => ChangeFilterSecondValue(condition, args)" /></label> }
                    }
                }
                <button class="button button-secondary button-small" type="button" @onclick="() => ToggleNegation(node)">@(node.IsNegated ? "Remove NOT" : "NOT")</button><button class="button button-secondary button-small" type="button" @onclick="() => DuplicateNode(node)">Duplicate</button><button class="filter-remove" type="button" aria-label="Remove filter expression" @onclick="() => RemoveNode(node)">×</button>
            </div>
        }
    </div>
    <div class="editor-card selection-card"><div class="panel-heading"><h2>6. Query Parameters</h2><button class="button button-secondary button-small" type="button" @onclick="AddParameter">Add parameter</button></div>
        @if (parameters.Count == 0) { <p class="muted">Declare reusable inputs, then reference them from filter operands.</p> }
        @foreach (var parameter in parameters)
        {
            <div class="parameter-row" @key="parameter.Id">
                <label><span>Name</span><input class="parameter-name" value="@parameter.Name" @oninput="args => ChangeParameterName(parameter, args)" /></label>
                <label><span>Display name</span><input class="parameter-display-name" value="@parameter.DisplayName" @oninput="args => ChangeParameterDisplayName(parameter, args)" /></label>
                <label><span>Type</span><select class="parameter-type" value="@parameter.Type" @onchange="args => ChangeParameterType(parameter, args)">@foreach (var type in ParameterTypes) { <option value="@type">@type</option> }</select></label>
                <label class="filter-toggle"><input class="parameter-required" type="checkbox" checked="@parameter.IsRequired" @onchange="args => ChangeParameterRequired(parameter, (bool?)args.Value == true)" /><span>Required</span></label>
                <label><span>Default</span><input class="parameter-default" type="@InputType(parameter.Type)" value="@parameter.DefaultValue" @oninput="args => ChangeParameterDefault(parameter, args)" /></label>
                <button class="filter-remove" type="button" aria-label="Remove Query Parameter @parameter.Name" @onclick="() => RemoveParameter(parameter)">×</button>
            </div>
        }
    </div>
</section>

@if (parameters.Count > 0)
{
    <section class="preview-panel parameter-run" aria-labelledby="parameter-values-title"><h2 id="parameter-values-title">Run inputs</h2><div class="parameter-inputs">
        @foreach (var parameter in parameters)
        {
            <label><span>@parameter.DisplayName@if (parameter.IsRequired) { <text> *</text> }</span>@if (parameter.Type == NormalizedTypeCategory.Boolean) { <input type="checkbox" checked="@RuntimeBoolean(parameter)" @onchange="args => ChangeRuntimeBoolean(parameter, (bool?)args.Value == true)" /> } else { <input type="@InputType(parameter.Type)" value="@parameter.RuntimeValue" @oninput="args => ChangeRuntimeValue(parameter, args)" /> }</label>
        }
    </div></section>
}

@if (preview?.Diagnostics.Count > 0) { <section class="feedback feedback-error" role="alert" aria-labelledby="validation-title"><h2 id="validation-title">Query Definition needs attention</h2><ul>@foreach (var diagnostic in preview.Diagnostics) { <li><code>@diagnostic.Code</code> @diagnostic.Message</li> }</ul></section> }
else if (preview?.Status == QueryPreviewStatus.Failed) { <section class="feedback feedback-error" role="alert"><h2>Query Preview failed</h2><p>@preview.FailureMessage</p></section> }

@if (preview?.GeneratedSql is not null) { <section class="preview-panel" aria-labelledby="sql-title"><div class="panel-heading"><h2 id="sql-title">Generated SQL</h2><span>Values remain parameterized</span></div><pre><code>@preview.GeneratedSql</code></pre></section> }

@if (preview?.Result is not null)
{
    <section class="preview-panel" aria-labelledby="results-title"><div class="panel-heading"><h2 id="results-title">Dynamic Result</h2><span>@preview.Result.RowCount rows · @preview.Result.Duration.TotalMilliseconds.ToString("N0") ms@if (preview.Result.WasTruncated) { <text> · Truncated</text> }</span></div>
        @if (preview.Result.RowCount == 0) { <p class="empty-result">The Query Preview returned no rows.</p> }
        else { <div class="result-wrap"><table><thead><tr>@foreach (var column in preview.Result.Columns) { <th scope="col">@column.Name<small>@column.NormalizedType</small></th> }</tr></thead><tbody>@foreach (var row in preview.Result.Rows) { <tr>@foreach (var value in row.Values) { <td>@FormatValue(value)</td> }</tr> }</tbody></table></div> }
    </section>
}

@code {
    private IReadOnlyList<DataSourceSummary> dataSources = [];
    private IReadOnlyList<SavedQuerySummary> savedQueries = [];
    private Guid? selectedSavedQueryId;
    private string queryName = string.Empty;
    private string queryDescription = string.Empty;
    private bool isDirty;
    private ValidationDiagnostic? saveDiagnostic;
    private string? commandMessage;
    private Guid? selectedDataSourceId;
    private DataSourceSchema? schema;
    private string selectedObjectName = string.Empty;
    private Guid sourceId = Guid.NewGuid();
    private readonly List<EditorSelection> selections = [];
    private readonly List<QueryJoin> joins = [];
    private string joinObjectName = string.Empty;
    private string joinRelationshipName = string.Empty;
    private string joinLeftColumn = string.Empty;
    private string joinRightColumn = string.Empty;
    private Guid joinLeftSourceId;
    private string joinAlias = string.Empty;
    private QueryJoinType joinType;
    private bool showJoinEditor;
    private EditorGroup filterRoot = new(QueryFilterGroupOperator.And);
    private readonly List<EditorParameter> parameters = [];
    private static readonly NormalizedTypeCategory[] ParameterTypes = [NormalizedTypeCategory.Text, NormalizedTypeCategory.Integer, NormalizedTypeCategory.Decimal, NormalizedTypeCategory.FloatingPoint, NormalizedTypeCategory.Boolean, NormalizedTypeCategory.Date, NormalizedTypeCategory.DateTime, NormalizedTypeCategory.Guid];
    private QueryPreviewResponse? preview;
    private bool isPreviewing;
    private SchemaDatabaseObject? SelectedObject => schema?.Objects.SingleOrDefault(item => item.QualifiedName.DisplayName == selectedObjectName);
    private SchemaDatabaseObject? JoinObject => schema?.Objects.SingleOrDefault(item => item.QualifiedName.DisplayName == joinObjectName);
    private SchemaDatabaseObject? JoinLeftObject => LogicalSources().SingleOrDefault(item => item.Source.Id == joinLeftSourceId).Object;
    private IReadOnlyList<SchemaRelationship> JoinRelationships => JoinLeftObject is null || JoinObject is null || schema is null ? [] : schema.FindRelationships(JoinLeftObject.QualifiedName, JoinObject.QualifiedName);
    private bool CanAddJoin => JoinObject is not null && (joinRelationshipName != "manual" && JoinRelationships.Any(item => item.Name == joinRelationshipName) || joinRelationshipName == "manual" && !string.IsNullOrEmpty(joinLeftColumn) && !string.IsNullOrEmpty(joinRightColumn));
    private bool CanSaveDefinition => selectedDataSourceId is not null && SelectedObject is not null && selections.Count > 0 && !string.IsNullOrWhiteSpace(queryName) && saveDiagnostic is null;
    private bool CanSaveMetadata => selectedSavedQueryId is not null && saveDiagnostic is not null && !string.IsNullOrWhiteSpace(queryName);
    protected override async Task OnInitializedAsync() { dataSources = await DataSourceService.ListAsync(); savedQueries = await SavedQueryService.ListAsync(); }
    private async Task ChangeDataSourceAsync(ChangeEventArgs args) { if (!await ConfirmDiscardAsync()) return; selectedDataSourceId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null; schema = selectedDataSourceId is null ? null : await SchemaService.GetAsync(selectedDataSourceId.Value); savedQueries = selectedDataSourceId is null ? [] : await SavedQueryService.ListAsync(selectedDataSourceId.Value); selectedSavedQueryId = null; queryName = string.Empty; queryDescription = string.Empty; ResetSource(); MarkDirty(); }
    private void ChangeObject(ChangeEventArgs args) { selectedObjectName = args.Value?.ToString() ?? string.Empty; sourceId = Guid.NewGuid(); selections.Clear(); joins.Clear(); ResetJoinDraft(); filterRoot = new(QueryFilterGroupOperator.And); preview = null; MarkDirty(); }
    private void ResetSource() { selectedObjectName = string.Empty; sourceId = Guid.NewGuid(); selections.Clear(); joins.Clear(); ResetJoinDraft(); filterRoot = new(QueryFilterGroupOperator.And); parameters.Clear(); preview = null; }
    private IReadOnlyList<(QuerySource Source, SchemaDatabaseObject Object)> LogicalSources() { var result = new List<(QuerySource, SchemaDatabaseObject)>(); if (SelectedObject is not null) result.Add((new(sourceId, SelectedObject.QualifiedName, "Source"), SelectedObject)); foreach (var join in joins) { var item = schema?.Objects.SingleOrDefault(candidate => candidate.QualifiedName == join.Source.Object); if (item is not null) result.Add((join.Source, item)); } return result; }
    private bool IsSelected(Guid selectedSourceId, string columnName) => selections.Any(item => item.SourceId == selectedSourceId && item.ColumnName == columnName);
    private void ToggleColumn(QuerySource selectedSource, SchemaColumn column, bool selected) { if (selected && !IsSelected(selectedSource.Id, column.Name)) selections.Add(new(selectedSource.Id, column.Name, SafeOutputName(selectedSource.Alias is null ? column.Name : $"{selectedSource.Alias}_{column.Name}"))); if (!selected) selections.RemoveAll(item => item.SourceId == selectedSource.Id && item.ColumnName == column.Name); MarkDirty(); }
    private string SelectionLabel(EditorSelection selection) { var source = LogicalSources().SingleOrDefault(item => item.Source.Id == selection.SourceId).Source; return $"{source?.Alias ?? source?.Object.DisplayName ?? "Unknown"}.{selection.ColumnName}"; }
    private void Move(int index, int offset) { var item = selections[index]; selections.RemoveAt(index); selections.Insert(index + offset, item); MarkDirty(); }
    private void Remove(int index) { selections.RemoveAt(index); MarkDirty(); }
    private async Task PreviewAsync() { var definition = CurrentDefinition(); if (selectedDataSourceId is null || definition is null) return; isPreviewing = true; try { preview = await PreviewService.PreviewAsync(selectedDataSourceId.Value, definition, RuntimeValues()); } finally { isPreviewing = false; } }
    private IReadOnlyDictionary<string, string?> RuntimeValues() { var values = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase); foreach (var parameter in parameters) values.TryAdd(parameter.Name, parameter.RuntimeValue); return values; }
    private void ChangeName(ChangeEventArgs args) { queryName = args.Value?.ToString() ?? string.Empty; MarkDirty(); }
    private void ChangeDescription(ChangeEventArgs args) { queryDescription = args.Value?.ToString() ?? string.Empty; MarkDirty(); }
    private void ChangeOutputName(EditorSelection selection, ChangeEventArgs args) { selection.OutputName = args.Value?.ToString() ?? string.Empty; MarkDirty(); }
    private void MarkDirty() { isDirty = true; commandMessage = null; }
    private QueryDefinition? CurrentDefinition() => selectedDataSourceId is null || SelectedObject is null ? null : new(QueryDefinition.CurrentVersion, new(sourceId, SelectedObject.QualifiedName, "Source"), selections.Select(item => new QuerySelection(item.SourceId, item.ColumnName, item.OutputName)).ToArray(), FilterExpression: filterRoot.Children.Count == 0 ? null : ToQueryExpression(filterRoot), Parameters: parameters.Select(item => item.ToDefinition()).ToArray(), Joins: joins.ToArray());
    private async Task SaveAsync() { if (CanSaveMetadata && selectedSavedQueryId is Guid id) { await SavedQueryService.UpdateMetadataAsync(id, queryName, queryDescription); savedQueries = await SavedQueryService.ListAsync(selectedDataSourceId!.Value); isDirty = false; commandMessage = "Saved Query metadata updated."; return; } await PersistAsync(selectedSavedQueryId); }
    private async Task SaveAsAsync() => await PersistAsync(null);
    private async Task PersistAsync(Guid? id) { var definition = CurrentDefinition(); if (selectedDataSourceId is null || definition is null) return; try { selectedSavedQueryId = await SavedQueryService.SaveAsync(id, new(selectedDataSourceId.Value, queryName, queryDescription, definition)); savedQueries = await SavedQueryService.ListAsync(selectedDataSourceId.Value); isDirty = false; saveDiagnostic = null; commandMessage = id is null ? "Saved as a new Saved Query." : "Saved Query updated."; } catch (SavedQueryValidationException exception) { saveDiagnostic = new("query.saved.invalid", string.Join(" ", exception.Diagnostics)); } }
    private async Task OpenSavedQueryAsync(ChangeEventArgs args) { if (!await ConfirmDiscardAsync()) return; if (!Guid.TryParse(args.Value?.ToString(), out var id)) { selectedSavedQueryId = null; return; } await LoadSavedQueryAsync(id); }
    private async Task LoadSavedQueryAsync(Guid id) { var saved = await SavedQueryService.GetAsync(id); if (saved is null) return; selectedSavedQueryId = saved.Id; selectedDataSourceId = saved.DataSourceId; schema = await SchemaService.GetAsync(saved.DataSourceId); savedQueries = await SavedQueryService.ListAsync(saved.DataSourceId); queryName = saved.Name; queryDescription = saved.Description; saveDiagnostic = saved.Diagnostic; preview = null; selections.Clear(); joins.Clear(); ResetJoinDraft(); filterRoot = new(QueryFilterGroupOperator.And); parameters.Clear(); if (saved.Definition is not null) { sourceId = saved.Definition.Source.Id; selectedObjectName = saved.Definition.Source.Object.DisplayName; selections.AddRange(saved.Definition.Selections.Select(item => new EditorSelection(item.SourceId, item.ColumnName, item.OutputName))); joins.AddRange(saved.Definition.AvailableJoins); filterRoot = saved.Definition.FilterExpression is null ? EditorGroup.FromLegacy(saved.Definition.AvailableFilters) : EditorGroup.FromExpression(saved.Definition.FilterExpression); parameters.AddRange(saved.Definition.AvailableParameters.Select(EditorParameter.From)); } else { selectedObjectName = string.Empty; sourceId = Guid.NewGuid(); } isDirty = false; commandMessage = null; }
    private void ChangeJoinLeftSource(ChangeEventArgs args) { joinLeftSourceId = Guid.TryParse(args.Value?.ToString(), out var value) ? value : sourceId; joinRelationshipName = string.Empty; joinLeftColumn = string.Empty; joinRightColumn = string.Empty; }
    private void ChangeJoinObject(ChangeEventArgs args) { joinObjectName = args.Value?.ToString() ?? string.Empty; joinRelationshipName = string.Empty; joinLeftColumn = string.Empty; joinRightColumn = string.Empty; }
    private void ChangeJoinRelationship(ChangeEventArgs args) { joinRelationshipName = args.Value?.ToString() ?? string.Empty; joinLeftColumn = string.Empty; joinRightColumn = string.Empty; }
    private void ChangeJoinType(ChangeEventArgs args) { if (Enum.TryParse<QueryJoinType>(args.Value?.ToString(), out var value)) joinType = value; }
    private IEnumerable<SchemaColumn> CompatibleJoinColumns() { var left = JoinLeftObject?.Columns.SingleOrDefault(item => item.Name == joinLeftColumn); return left is null || JoinObject is null ? [] : JoinObject.Columns.Where(item => item.NormalizedType != NormalizedTypeCategory.Unknown && item.NormalizedType == left.NormalizedType); }
