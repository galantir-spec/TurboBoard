@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="app-shell">
    <aside class="sidebar" aria-label="Application sidebar">
        <a class="brand" href="/" aria-label="TurboBoard overview">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" />
                </svg>
            </span>
            <span class="brand-copy">
                <strong>TurboBoard</strong>
                <small>Dynamic SQL workspace</small>
            </span>
        </a>

        <nav class="primary-navigation" aria-label="Primary navigation">
            <span class="navigation-label">Workspace</span>
            <NavLink href="/" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 12l9-9 9 9v8a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" />
                </svg>
                <span>Overview</span>
            </NavLink>
            <NavLink href="data-sources">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <ellipse cx="12" cy="5" rx="8" ry="3" />
                    <path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7" />
                </svg>
                <span>Data Sources</span>
            </NavLink>
            <NavLink href="queries">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 4h16v16H4zM8 9h8M8 13h5M8 17h7" />
                </svg>
                <span>Queries</span>
            </NavLink>
        </nav>

        <div class="workspace-status" aria-label="Workspace status">
            <span class="status-indicator" aria-hidden="true"></span>
            <span>
                <strong>Local workspace</strong>
                <small>Ready for configuration</small>
            </span>
        </div>
    </aside>

    <div class="workspace">
        <header class="topbar">
            <span class="topbar-context">Trusted analytics workspace</span>
            <span class="environment-badge">Self-hosted</span>
        </header>
        <main id="main-content" class="main-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    TurboBoard encountered an unexpected error.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">Dismiss</button>
</div>
